#!/usr/bin/env bash
# {{ ansible_managed }}
# Keep the boot chain under {{ uki_boot_dir }} in sync with the packaged shim
# and the host-signed systemd-boot.
set -euo pipefail

refresh() {
  if ! cmp -s "$1" "$2"; then
    echo "updating $2 from $1"
    cp -f "$1" "$2"
  fi
}

refresh {{ uki_shim_dir }}/shimx64.efi {{ uki_boot_dir }}/shimx64.efi
refresh {{ uki_shim_dir }}/mmx64.efi {{ uki_boot_dir }}/mmx64.efi

if ! sbverify --cert {{ uki_mok_crt }} {{ uki_grubx64 }} >/dev/null 2>&1; then
  echo "{{ uki_grubx64 }} lost the host MOK signature; re-signing systemd-boot over it"
  sbsign --key {{ uki_mok_key }} --cert {{ uki_mok_crt }} \
    --output {{ uki_grubx64 }} {{ uki_sdboot_efi }}
fi
{% if uki_install_fallback %}
refresh {{ uki_boot_dir }}/shimx64.efi {{ uki_fallback_dir }}/BOOTX64.EFI
refresh {{ uki_boot_dir }}/mmx64.efi {{ uki_fallback_dir }}/mmx64.efi
refresh {{ uki_grubx64 }} {{ uki_fallback_dir }}/grubx64.efi
rm -f {{ uki_fallback_dir }}/fbx64.efi
{% endif %}
