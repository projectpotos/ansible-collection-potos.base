#!/bin/bash
# {{ ansible_managed }}
#
# Runs the periodic potos ansible playbook against localhost to enforce
# {{ potos_basics_client_name }} client specification. Notifications and warnings
# are displayed to the end user when:
{% if potos_basics_enable_reboot_reminder %}
#  * the machine has not been rebooted for more than {{ potos_basics_reboot_reminder_days }} days
{% endif %}
#  * ansible reports failures
#
# usage: {{ potos_basics_client_name | lower }}-ansible-pull [-h|--help] [-v|--verbose] [-r|--runtype <runtype>]

set -eu
set -o pipefail

WORKDIR="{{ potos_basics_workdir }}"
VENVDIR="{{ potos_basics_virtenvdir }}"
LOGDIR="{{ potos_basics_logdir }}"
INVENTORY="{{ potos_basics_inventory }}"
LOCK="/var/lock/{{ potos_basics_client_name | lower }}.lock"
SPECS_DIR="{{ potos_basics_specs_clone_dir }}"
SPECS_GALAXY_DIR="{{ potos_basics_specs_galaxy_dir }}"
VAULT_KEY="{{ potos_basics_ansible_vault_key_file }}"
LOG="${LOGDIR}/ansible-pull.log"
ANSIBLE_PLAYBOOK="${VENVDIR}/bin/ansible-playbook"
export ANSIBLE_COLLECTIONS_PATH="${ANSIBLE_COLLECTIONS_PATH:-/usr/share/ansible/collections}"

die () { printf '%s\n' "$1" >&2; exit 1; }

Help() {
    cat <<'HELPEOF'
Pulls the latest potos specs and runs ansible against localhost
to enforce {{ potos_basics_client_name }} client specification.

usage: {{ potos_basics_client_name | lower }}-ansible-pull [-h|--help] [-v|--verbose] [-r|--runtype <runtype>]

  -h|--help     Print this help.
  -v|--verbose  Verbose mode (do not silence stdout/stderr).
  -r|--runtype  Run type, one of: {% for r in potos_basics_runtypes %}{{ r.runtype }}{% if not loop.last %}, {% endif %}{% endfor %}.
HELPEOF
}

VERBOSE=false
RUN_TYPE="{{ (potos_basics_runtypes | selectattr('on_calendar', 'defined') | list | first).runtype | default('daily') }}"

while :; do
  case "${1:-}" in
    -h|--help) Help; exit 0 ;;
    -v|--verbose) VERBOSE=true; shift ;;
    -r|--runtype)
      case "${2:-}" in
{% for r in potos_basics_runtypes %}
        {{ r.runtype }}) RUN_TYPE="{{ r.runtype }}" ;;
{% endfor %}
        *) die "Invalid run type '${2:-}'. Allowed: {% for r in potos_basics_runtypes %}{{ r.runtype }}{% if not loop.last %}, {% endif %}{% endfor %}." ;;
      esac
      shift 2
      ;;
    --) shift; break ;;
    -?*) printf 'WARN: unknown option (ignored): %s\n' "$1" >&2; shift ;;
    *) break ;;
  esac
done

{% if not potos_basics_always_verbose %}
if ! ${VERBOSE}; then exec >>"${LOG}" 2>&1; fi
{% endif %}

for tool in /usr/bin/awk /usr/bin/bc /usr/bin/date /usr/bin/flock /usr/bin/git \
            /usr/bin/grep /usr/bin/mkdir /usr/bin/notify-send /usr/bin/sed \
            /usr/bin/tail /usr/bin/touch /usr/bin/tr /usr/bin/uptime \
            /usr/bin/wall /usr/bin/nmcli; do
  [ -x "${tool}" ] || die "Required tool '${tool}' not available!"
done

# use flock to prevent concurrent runs
mkdir -p /var/lock || die "Failed to create lock directory"
[ -f "${LOCK}" ] || touch "${LOCK}" || die "Failed to create lock file"
exec {flockfd}<"${LOCK}"
/usr/bin/flock -n "${flockfd}" || die "Other instance already running, aborting"

# Check connectivity
[ $( LANG=C /usr/bin/nmcli -g CONNECTIVITY g status ) == "full" ] || die "Insufficient connectivity, aborting"

mkdir -p "${WORKDIR}" "${LOGDIR}" || die "Failed to create work/log directories"

VAULT_OPT=()
if [ -f "${VAULT_KEY}" ]; then
  VAULT_OPT=("--vault-password-file=${VAULT_KEY}")
fi

RC=0
export ANSIBLE_LOG_PATH="${LOG}"

echo "=== potos: stage 1 (prepare) - runtype=${RUN_TYPE} ===" >&2
"${ANSIBLE_PLAYBOOK}" \
  -i "${INVENTORY}" \
  "${VAULT_OPT[@]}" \
  -e "potos_runtype=${RUN_TYPE}" \
  potos.base.prepare \
  || RC=$?

# Skipped when stage 1 didn't produce a specs clone (e.g. no specs URL configured yet, or stage 1 failed).
if [ "${RC}" -eq 0 ] && [ -f "${SPECS_DIR}/runtime.yml" ]; then
  echo "=== potos: stage 2 (apply) - runtype=${RUN_TYPE} ===" >&2
  STAGE2_INV_OPT=("-i" "${INVENTORY}")
  if [ -d "${SPECS_DIR}/inventory" ]; then
    STAGE2_INV_OPT+=("-i" "${SPECS_DIR}/inventory")
  fi
  ANSIBLE_COLLECTIONS_PATH="${SPECS_GALAXY_DIR}/collections:/usr/share/ansible/collections" \
  ANSIBLE_ROLES_PATH="${SPECS_GALAXY_DIR}/roles" \
    "${ANSIBLE_PLAYBOOK}" \
      "${STAGE2_INV_OPT[@]}" \
      "${VAULT_OPT[@]}" \
      -e "potos_runtype=${RUN_TYPE}" \
      -e "potos_specs_dir=${SPECS_DIR}" \
      potos.base.apply \
      || RC=$?
fi

if [ "${RC}" -ne 0 ] || /usr/bin/grep -q 'failed=[1-9]' "${LOG}" 2>/dev/null; then
  MSG="Attention: {{ potos_basics_client_name }} ansible run (${RUN_TYPE}) failed.
{% for line in potos_basics_on_error_additional_lines %}
{{ line }}
{% endfor %}"
  /usr/bin/notify-send -u critical --expire-time=0 "${MSG}" || true
  /usr/bin/wall "${MSG}" || true
fi

exec {flockfd}<&-

{% if potos_basics_enable_reboot_reminder %}
UPTIME_DATE=$(/usr/bin/uptime --since | /usr/bin/awk '{print $1}' | /usr/bin/tr -d '-')
TODAY=$(/usr/bin/date +%Y%m%d)
DAYS_DIFF=$(/usr/bin/echo "( $(/usr/bin/date -d ${TODAY} +%s) - $(/usr/bin/date -d ${UPTIME_DATE} +%s)) / (24*3600)" | /usr/bin/bc)
if [ "${DAYS_DIFF}" -gt "{{ potos_basics_reboot_reminder_days }}" ]; then
  UPTIME_MSG="Your $(hostname) has been up for ${DAYS_DIFF} days (> {{ potos_basics_reboot_reminder_days }}).
Consider rebooting to keep the system secure."
  echo "${UPTIME_MSG}"
  /usr/bin/notify-send -u normal --expire-time=0 "${UPTIME_MSG}" || true
  /usr/bin/wall "${UPTIME_MSG}" || true
fi
{% endif %}

exit "${RC}"
