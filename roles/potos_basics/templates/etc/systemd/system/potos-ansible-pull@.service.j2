# {{ potos_basics_client_name }}-ansible-pull@.service
# {{ ansible_managed }}
[Unit]
Description=Runs ansible pull for {{ potos_basics_client_name }} client ({{ '%i' }})
AssertPathExists={{ potos_basics_workdir }}
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/{{ potos_basics_client_name | lower }}-ansible-pull -r %i
