#!/usr/bin/env bash

ALLCOLS=$(
  sed '/^! layout$/,/^ *$/!d;//d' /usr/share/X11/xkb/rules/base.lst | sort -k 2 | while read -r layout description; do
    description=$(echo "${description}" | tr " " "_")
    echo "${layout} ${description}"
  done
)

KEYBOARD_LAYOUT="$(yad --width 600 --height 600 --list --column 'Keyboard Layout' \
  --column '' ${ALLCOLS} \
  --print-column 1 --button OK:0 \
  --image /usr/share/icons/Adwaita/48x48/apps/accessories-character-map-symbolic.symbolic.png \
  --text '{{ potos_steps_ask_select_keyboardlayout | default("Please select a keyboard layout") }}')"

# yad appends the field separator to --print-column output; strip it.
KEYBOARD_LAYOUT=$(echo "${KEYBOARD_LAYOUT}" | tr -d '|')

# Fall back to a default when the user cancelled or selected nothing.
if [[ -z "${KEYBOARD_LAYOUT}" ]]; then
  KEYBOARD_LAYOUT="us"
fi

# Apply to the running X session so the layout is active immediately (e.g. for
# the password fields shown after this dialog).
if command -v setxkbmap >/dev/null 2>&1; then
  setxkbmap "${KEYBOARD_LAYOUT}" >/dev/null 2>&1 || true
fi

# Best-effort GNOME session setting.
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.input-sources sources \
    "[('xkb', '${KEYBOARD_LAYOUT}')]" >/dev/null 2>&1 || true
fi

# Persist config
if command -v localectl >/dev/null 2>&1; then
  localectl set-x11-keymap "${KEYBOARD_LAYOUT}" >/dev/null 2>&1 || true
fi

echo "${KEYBOARD_LAYOUT}"
